# ═══════════════════════════════════════════════════════════════════
#  YasRose — Environment Variables
#  انسخي هذا الملف إلى .env وعبئي القيم الصحيحة
# ═══════════════════════════════════════════════════════════════════

# ─── Backend API Base URL ─────────────────────────────────────────
# لما يتربط الـ backend، غيري الـ URL ده
VITE_API_URL=http://localhost:3001/api

# ─── Unsplash (للصور) ────────────────────────────────────────────
VITE_UNSPLASH_ACCESS_KEY=

# ─── Payment Gateway ──────────────────────────────────────────────
VITE_PAYMENT_PUBLIC_KEY=

# ─── Google Maps (للتتبع) ─────────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=
